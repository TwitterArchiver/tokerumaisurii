              "title": "Prisma ORM without Rust: Latest Performance Benchmarks",
              "unwound_url": "https://www.prisma.io/blog/prisma-orm-without-rust-latest-performance-benchmarks?utm_source=blog&utm_content=launch-blog&via=prisma7",
