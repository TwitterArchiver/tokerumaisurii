      "urls": [
        {
          "description": "快科技10月5日消息，对于使用iPhone的用户来说，很快也能享受到地震预警信息提示了。近日有公众向中国地震局询问：地震局能否在地震系统上制作iOS预警应用呢？以及小区广播功能？另外能否推进在地震预警上的0级短信覆盖呢？对此，地震局监测司回复：中国地震局高度重",
          "display_url": "finance.sina.cn/tech/2025-10-0…",
          "end": 204,
          "expanded_url": "https://finance.sina.cn/tech/2025-10-05/detail-infsvsep3459125.d.html?vt=4",
          "start": 181,
          "status": 200,
          "title": "果粉终于等到！中国地震局：推进地震预警信息接入苹果iOS系统功能",
          "unwound_url": "https://finance.sina.cn/tech/2025-10-05/detail-infsvsep3459125.d.html?vt=4",
          "url": "https://t.co/ctrHVCpoyb"
        }
      ]
    },
